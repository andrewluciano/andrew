.conteudo{
	width:96%;
	height:auto;
	display:table;
	margin:0px auto;
	position:relative;
	margin-top:5px;
	margin-bottom:5px;	
}

.conteudo p{
	font-size:12px;
	color:#3a3a3c;
	margin:0px auto;
	width:100%;
	text-align:justify;
}


.conteudo-posts{
	position:relative;
	margin:10px 0px 10px 0px;
	border-bottom:1px dotted #dfdfdf;
	padding:0px 0px 20px 0px;
	width:100%;
}

.portfolio h1{
	margin:0px !important;	
}

.conteudo-posts img, .entry-content img{
	position:relative;
	margin:0px;
	border:1px solid #dfdfdf !important;
}


.entry-meta{
	text-align:right;
	font-size:10px;
	position:relative;
	float:right;
	width:100%;
	margin:0px 0px 10px 0px;
	top:-20px;
}
.entry-content{
	position:relative;

	width:100%;
	margin:10px 0px 20px 0px;
	
}
.navigation{
	display:none;
	
}