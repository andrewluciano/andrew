body{
	margin:0px;
	padding:0px;
	font-family:Helvetica, Tahoma;
	font-size:14px;
	color:#4f3c18;
	background-image:url('../imagens/background-site.gif');
	background-repeat:repeat-x;
	background-position:top;	
	background-color:#fff;	
}

h6{
	width:277px;
	height:85px;
	margin:0px;
	padding:0px;
	background-image:url('../imagens/logo-drew.png');
	background-repeat:no-repeat;
	background-position:center;
	text-indent:-90000px;
	position:absolute;
	top:17px;
}
a img{
		border:none;	
}
.global{
	width:840px;
	height:auto;
	margin:auto;
}
p{line-height:18px;}

strong{	color:#6c7b21; font-size:14px;}
a{color:#6c7b21; text-decoration:underline;}
a:hover{color:#6c7b21; text-decoration:none;}



h3 a{
	color:#4f3c18;
	text-decoration:none;
}






.lista-servicos p a{
	float:left;
	display:block;
	width:100%;
	position:relative;
	margin-bottom:10px;

	
}


.link-completo{
	width:500px;
	padding:5px;
	font-size:12px;
	color:#999;
	border:1px solid #dfdfdf;
}

.more-link{
	display:block;
	width:100%;
	position:relative;
	margin:10px 0px 0px 0px;
	font-size:11px;
	font-weight:bold;
	text-decoration:none;	
	
}